@article{Fortin2007,
  title = {Mise Au Point d'un Tarif de Cubage G{\'e}n{\'e}ral Pour Les For{\^e}ts Qu{\'e}b{\'e}coises : Une Approche Pour Mieux {\'E}valuer l'incertitude Associ{\'e}e Aux Pr{\'e}visions},
  shorttitle = {Mise Au Point d'un Tarif de Cubage G{\'e}n{\'e}ral Pour Les For{\^e}ts Qu{\'e}b{\'e}coises},
  author = {Fortin, Mathieu and DeBlois, Josianne and Bernier, Sylvain and Blais, Georges},
  year = {2007},
  month = sep,
  journal = {The Forestry Chronicle},
  volume = {83},
  number = {5},
  pages = {754--765},
  publisher = {Canadian Institute of Forestry},
  issn = {0015-7546},
  doi = {10.5558/tfc83754-5},
  urldate = {2026-02-01},
  abstract = {R{\'e}sum{\'e}L'estimation du volume marchand est capitale pour l'am{\'e}nagement et le calcul de la possibilit{\'e} ligneuse des for{\^e}ts publiques du Qu{\'e}bec. Actuellement, cette estimation s'effectue {\`a} l'{\'e}chelle de la tige individuelle selon un mod{\`e}le statistique que l'on nomme commun{\'e}ment tarif de cubage g{\'e}n{\'e}ral de Perron. Ce mod{\`e}le, de type polynomial, repose sur le diam{\`e}tre {\`a} hauteur de poitrine et la hauteur de l'arbre. Or, la forme math{\'e}matique du mod{\`e}le et la m{\'e}thode utilis{\'e}e pour l'{\'e}talonner ne permettent pas d'{\'e}valuer correctement et de fa{\c c}on d{\'e}taill{\'e}e l'incertitude associ{\'e}e aux estimations du volume. Cette {\'e}tude propose un nouveau mod{\`e}le qui, d'une part, permet de prendre en compte les erreurs associ{\'e}es {\`a} l'utilisation d'une hauteur estim{\'e}e dans la pr{\'e}vision du volume et, d'autre part, facilite la propagation des erreurs jusqu'{\`a} l'{\'e}chelle de la placette et de la vir{\'e}e. Des effets al{\'e}atoires ont {\'e}t{\'e} sp{\'e}cifi{\'e}s dans le mod{\`e}le afin de prendre en compte la corr{\'e}lation spatiale entre les observations {\`a} l'{\'e}chelle de la placette et de la vir{\'e}e. Les r{\'e}sultats d{\'e}montrent que ces effets al{\'e}atoires de placette et de vir{\'e}e repr{\'e}sentent en fait des composantes de l'erreur du mod{\`e}le, lesquelles sont chacune de l'ordre de 2{\enspace}\% {\`a} 4{\enspace}\% de la pr{\'e}vision du volume. En cons{\'e}quence, le postulat voulant que les erreurs associ{\'e}es {\`a} la pr{\'e}vision du volume des tiges individuelles se compensent lors de la sommation des volumes {\`a} l'{\'e}chelle de la placette n'est pas valide. Mots cl{\'e}s : mod{\`e}le mixte, effet al{\'e}atoire, propagation des erreurs, variance},
  file = {C:\Users\ptompals\Zotero\storage\RD93ABPV\Fortin et al. - 2007 - Mise au point d'un tarif de cubage général pour les forêts québécoises  une approche pour mieux éva.pdf}
}


